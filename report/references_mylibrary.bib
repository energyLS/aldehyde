  title = {Measuring the {{Dunkelflaute}}: How (Not) to Analyze Variable Renewable Energy Shortage},
  shorttitle = {Measuring the {{Dunkelflaute}}},
  author = {Kittel, Martin and Schill, Wolf-Peter},
  year = {2024},
  month = aug,
