@article{McKenna2025,
  title = {System Impacts of Wind Energy Developments: {{Key}} Research Challenges and Opportunities},
  shorttitle = {System Impacts of Wind Energy Developments},
  author = {McKenna, Russell and Lilliestam, Johan and Heinrichs, Heidi U. and Weinand, Jann and Schmidt, Johannes and Staffell, Iain and Hahmann, Andrea N. and Burgherr, Peter and Burdack, Arne and Bucha, Monika and Chen, Ruihong and Klingler, Michael and Lehmann, Paul and Lowitzsch, Jens and Novo, Riccardo and Price, James and Sacchi, Romain and Scherhaufer, Patrick and Sch{\"o}ll, Eva M. and Visconti, Piero and {Velasco-Herrej{\'o}n}, Paola and Zeyringer, Marianne and Ramirez Camargo, Luis},
