@article{Dhondt,
  title = {Industrial {{Clustering}} for {{Multi-Node Energy System Modelling}}},
  author = {Dhondt, Nienke and Laveyne, Joannes and Eetvelde, Greet Van},
  abstract = {The European industry is facing major challenges, not only due to the current economic crisis but also to answer growing environmental and social requirements. This triple bottom line, known as the sustainability triangle, urges companies and communities to create more synergies, to form urbanindustrial and cross-sectoral hubs for circularity. Industrial clusters can be defined as geographical areas with a high density of energy-intensive industries and material interconnections, requiring guaranteed supply of energy and resources. The energy transport infrastructure providing this is under continuous re-assessment in order to answer changing spatial and temporal needs in supply and demand due to the energy transition, the integration of renewables and the consequences of disruptive events threatening global energy systems. Adjustments to the transnational electrical infrastructure and product backbones (natural gas, hydrogen, etc.), through expansion or repurposing, are necessary to maintain the security of energy supply; in particular for industrial clusters as they inform future energy strategies and technology innovation.},
