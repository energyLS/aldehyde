@article{Schumm2023,
  title = {Synergies and {{Conflicts}} of {{Hydrogen Export}} and {{National Energy Transition}} in {{Morocco}}},
  author = {Schumm, Leon and {Abdel-Khalek}, Hazem and Brown, Tom and Ueckerdt, Falko and Sterner, Michael and Parzen, Maximilian and Fioriti, Davide},
  year = {2023},
  journal = {[Under Review]},
  abstract = {Several countries are emerging as future potential exporters of green hydrogen, while simultaneously pursuing ambitious energy transitions to reduce greenhouse gas emissions. Morocco serves as a blueprint for countries aiming to design their energy systems along these two dimensions, risking technology lock-in, unabated local energy-related greenhouse gas emissions, rising local energy prices, land use implications and neo-colonialism. Extending the current state of research, we conduct an integrated analysis of synergies and con icts between these two objectives, taking into account the potential impact of hydrogen exports on economic bene ts for both local populations and hydrogen exporters. We present a fully sector-coupled capacity expansion and dispatch model of Morocco across 53 regions, including integrated gas pipeline and electricity network planning based on PyPSA-Earth. e applied sector-coupled model simulates and optimises the Moroccan energy system in more than 100 scenarios at a 3-hourly temporal resolution, sweeping through di erent hydrogen export volumes and climate targets. Results show that hydrogen exports could provide signi cant economic bene ts for both hydrogen exporters and the local population, but also create potential con icts and rising electricity and hydrogen prices. In addition, potential risks of neo-colonialism highlight the need for an integrated assessment of hydrogen exports and local decarbonisation. Integrated policies unlock synergies and minimise potential con icts between hydrogen exports and Morocco's energy transition, while ensuring social and environmental sustainability.},
  langid = {english},
  file = {C:\Users\scl38887\Zotero\storage\PNILC9CG\Schumm et al. - Synergies and Con icts of Hydrogen Export and Nati.pdf}
}

@misc{Schumm2024,
  title = {The Impact of Temporal Hydrogen Regulation on Hydrogen Exporters and Their Domestic Energy Transition},
  author = {Schumm, Leon and {Abdel-Khalek}, Hazem and Brown, Tom and Ueckerdt, Falko and Sterner, Michael and Fioriti, Davide and Parzen, Max},
  year = {2024},
  month = may,
  number = {arXiv:2405.14717},
  eprint = {2405.14717},
  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2405.14717},
  url = {http://arxiv.org/abs/2405.14717},
  urldate = {2024-07-17},
  abstract = {As global demand for green hydrogen rises, potential hydrogen exporters move into the spotlight. However, the large-scale installation of on-grid hydrogen electrolysis for export can have profound impacts on domestic energy prices and energy-related emissions. Our investigation explores the interplay of hydrogen exports, domestic energy transition and temporal hydrogen regulation, employing a sector-coupled energy model in Morocco. We find substantial co-benets of domestic climate change mitigation and hydrogen exports, whereby exports can reduce domestic electricity prices while mitigation reduces hydrogen export prices. However, increasing hydrogen exports quickly in a system that is still dominated by fossil fuels can substantially raise domestic electricity prices, if green hydrogen production is not regulated. Surprisingly, temporal matching of hydrogen production lowers domestic electricity cost by up to 31\% while the effect on exporters is minimal. This policy instrument can steer the welfare (re-)distribution between hydrogen exporting firms, hydrogen importers, and domestic electricity consumers and hereby increases acceptance among actors.},
  archiveprefix = {arXiv},
  keywords = {Physics - Physics and Society},
  file = {C\:\\Users\\scl38887\\Zotero\\storage\\AY6NJ5TK\\Schumm et al. - 2024 - The impact of temporal hydrogen regulation on hydr.pdf;C\:\\Users\\scl38887\\Zotero\\storage\\BSXT6HVH\\2405.html}
}

