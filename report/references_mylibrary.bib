@article{EkFalth2023,
  title = {Trade-Offs between Aggregated and Turbine-Level Representations of Hydropower in Optimization Models},
  author = {Ek F{\"a}lth, H. and Mattsson, N. and Reichenberg, L. and Hedenus, F.},
  year = {2023},
  month = sep,
  journal = {Renewable and Sustainable Energy Reviews},
  volume = {183},
  pages = {113406},
  issn = {1364-0321},
  doi = {10.1016/j.rser.2023.113406},
  url = {https://www.sciencedirect.com/science/article/pii/S1364032123002630},
  urldate = {2023-12-14},
  abstract = {To model a future power system with high shares of variable renewables, it is essential to capture the flexibility of dispatchable technologies such as hydropower. However, the representation of hydropower is often oversimplified in energy system investment models, such that the flexibility of hydropower is significantly exaggerated. This suggests the need for improved representations of hydropower that capture physical river dynamics but are computationally efficient to maintain the tractability of large models. Here, we develop a series of hydropower optimization models for a single river with various levels of techno-physical detail to evaluate options for hydropower representations in energy system investment models. All models operate hourly over a full year with perfect foresight. We explore trade-offs between accuracy and computational time involved in including features such as the river network, head-dependent power production, and discharge-dependent turbine efficiencies. We find that the level of detail significantly affects the optimal production and confirm that a simplistic hydropower representation similar to those often used in investment models significantly overestimates the flexibility of hydropower. The most detailed nonconvex model includes a full river network, head-dependency, and turbine efficiencies and is solved in just one hour on a modern desktop computer. Furthermore, we linearize this detailed model, thereby reducing computation time to one minute while featuring production dynamics substantially more similar to the full nonconvex model than a naive linear network model. These contributions pave the way for improving hydropower representations in investment models to avoid overestimating the flexibility that hydropower may provide.},
  keywords = {Aggregation,Energy system models,Head,Hydropower,Modeling,River network,Turbine efficiencies},
  file = {C:\Users\scl38887\Zotero\storage\AG7Y8JA2\S1364032123002630.html}
}

@article{Emelianova,
  title = {Welfare Redistribution through Different Flexibility Deployment Strategies - {{Who}} Pays?},
  author = {Emelianova, Polina and Namockel, Nils},
  abstract = {Achieving the goal of climate neutrality calls for a decarbonization of end-use sectors. Hereby, the primary strategy is electrification of end-use applications for heating and transportation. In particular Germany has defined specific technology targets for the year 2030. The increased penetration of new technologies such as electric vehicles and heat pumps, has far-reaching implications for the energy system, notably influencing the formation of electricity prices. Moreover, the distinct behavioral constraints associated with various flexibility options disrupt the existing equilibrium between consumer and producer rents. This paper aims to address the following research questions: What is the impact of different flexibility deployment strategies on producer and consumer rents? To what extend do households have to be compensated to provide systemoriented flexibility? To address these questions, we further enhance the existing electricity market model DIMENSION. First, we develop a high-resolution dispatch model for Europe. Second, we increase the granularity in end-use sectors to account for flexible use of electric vehicles, including Vehicle-to-Grid/Building (V2X), heat pumps and heat storage. Doing so, electricity costs can be assigned to the individual actors, allowing an analysis of technology-specific welfare effects. We find that additional deployment of flexibility lowers the total system cost. Furthermore, we show that different flexibility deployment strategies impact technology-specific consumer and producer rents. For example, while the end-user procurement costs can be lowered by utilizing flexible charging, the costs do not decrease further by providing V2X services. As increase in consumer rents might not be sufficient to offset investment costs required to deploy flexibility, financial incentive schemes might be needed to unlock flexibility potential.},
  langid = {english},
  file = {C:\Users\scl38887\Zotero\storage\J6YF9LR3\Emelianova and Namockel - Welfare redistribution through different flexibili.pdf}
}

