  author = {Mast, Tanja and Hofmann, Martin},
  abstract = {This paper aims to provide a holis{\dbend}c understanding of conges{\dbend}on management within the German power grid, considering both the transmission and distribu{\dbend}on grid levels. From an in-depth analysis of historical conges{\dbend}on management data, the topologies of the distribu{\dbend}on grids and their crucial role in preven{\dbend}ng conges{\dbend}on at the transmission level are derived. The paper demonstrates the need to consider these distribu{\dbend}on grid constraints in transmission grid models. A universal and easy-to-apply approach of linear distribu{\dbend}on grid factors is developed and allows the applica{\dbend}on in energy system models poten{\dbend}ally for posi{\dbend}ve and nega{\dbend}ve adjustments of generators and loads in the distribu{\dbend}on grid.},
