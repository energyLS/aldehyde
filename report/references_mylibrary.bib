@article{Ma2024,
  title = {Energy Supply Structure Optimization of Integrated Energy System Considering Load Uncertainty at the Planning Stage},
  author = {Ma, Xuran and Wang, Meng and Wang, Peng and Wang, Yixin and Mao, Ding and Kosonen, Risto},
  year = {2024},
  month = oct,
  journal = {Energy},
  volume = {305},
