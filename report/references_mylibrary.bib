@misc{Fonder2023,
  title = {Synthetic Methane for Closing the Carbon Loop: {{Comparative}} Study of Three Carbon Sources for Remote Carbon-Neutral Fuel Synthetization},
  shorttitle = {Synthetic Methane for Closing the Carbon Loop},
  author = {Fonder, Micha{\"e}l and Counotte, Pierre and Dachet, Victor and {de S{\'e}journet}, Jehan and Ernst, Damien},
  year = {2023},
  month = oct,
  number = {arXiv:2310.01964},
  eprint = {2310.01964},
  primaryclass = {math},
  publisher = {arXiv},
  url = {http://arxiv.org/abs/2310.01964},
  urldate = {2023-10-30},
  abstract = {Achieving carbon neutrality is probably one of the most important challenges of the 21st century for our societies. Part of the solution to this challenge is to leverage renewable energies. However, these energy sources are often located far away from places that need the energy, and their availability is intermittent, which makes them challenging to work with. In this paper, we build upon the concept of Remote Renewable Energy Hubs (RREHs), which are hubs located at remote places with abundant renewable energy sources whose purpose is to produce carbon-neutral synthetic fuels. More precisely, we model and study the Energy Supply Chain (ESC) that would be required to provide a constant source of carbon-neutral synthetic methane, also called e-NG, in Belgium from an RREH located in Morocco. To be carbon neutral, a synthetic fuel has to be produced from existing carbon dioxide (CO2) that needs to be captured using either Direct Air Capture (DAC) or Post Combustion Carbon Capture (PCCC). In this work, we detail the impact of three different carbon sourcing configurations on the price of the delivered e-NG. Our results show that PCCC is the most competitive from a cost perspective, and that e-NG could be delivered to Belgium at a price of 136{\texteuro}/MWh when using existing CO2 sources in Morocco. For comparison, this price is less than half of the one of regular fossil natural gas delivered in Belgium at the peak of the 2022 energy crisis in Europe.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Optimization and Control},
  file = {C:\Users\scl38887\Zotero\storage\CE3QBXPJ\Fonder et al. - 2023 - Synthetic methane for closing the carbon loop Com.pdf}
}

@article{Forum2023,
  title = {German-{{African Green Hydrogen Forum}} : {{Conference Proceedings}} ; {{May}} 23rd - 24th, {{Bernburg}} ({{Saale}})\${{dOrganized}} by: {{Prof}}. {{Dr}}. {{Markus Holz}}, {{Prof}}. {{Dr}}. {{Cornelia Scott}}, {{Sven Ortmann}}, {{Ana Beatriz Barbosa}}, {{Turiel}} Do {{Nascimento}}},
