@article{Palazzi2024,
  title = {Green Ammonia Imports Could Supplement Long-Duration Energy Storage in the {{UK}}},
  author = {Palazzi, Carlo and {Nayak-Luke}, Richard and Verschuur, Jasper and Salmon, Nicholas and Hall, Jim W and {Ba{\~n}ares-Alcantara}, Ren{\'e}},
  year = {2024},
  month = dec,
  journal = {Environmental Research: Energy},
  volume = {1},
  number = {4},
  pages = {043001},
  issn = {2753-3751},
  doi = {10.1088/2753-3751/ad785d},
  url = {https://iopscience.iop.org/article/10.1088/2753-3751/ad785d},
  urldate = {2024-10-14},
  abstract = {Abstract             There is growing recognition of the need for long-duration energy storage to cope with low frequency (i.e. seasonal to multi-annual) variability in renewable energy supplies. Recent analysis for the UK has estimated that 60--100 TWh of hydrogen storage could be required to provide zero-carbon backup for renewable energy supplies in 2050. However, the analysis did not consider the potential role of green energy imports as a supplement to domestic energy storage. Using a global spatially-explicit model of green hydrogen/ammonia production and shipping we estimate the lowest import costs for green ammonia to the UK, and compare them with the levelized costs of energy storage across scenarios of varying domestic renewable energy production. The results indicate that imported green ammonia could offer a cost-comparable alternative to domestic hydrogen production, storage and power generation, whilst increasing energy system resilience through supply diversification, at a similar or cheaper delivered energy cost compared to a hydrogen-only storage system. In countries lacking the geological potential for low-cost hydrogen storage, green ammonia imports could have an even more significant role.},
  langid = {english},
  file = {C:\Users\scl38887\Zotero\storage\L33EEY2D\Palazzi et al. - 2024 - Green ammonia imports could supplement long-durati.pdf}
}

@unpublished{Palmer2024,
  title = {Green and Low-Carbon Hydrogen - the Impact of Classification Rules and Subsidies on Asset Sizing and Energy Sourcing for Electrolytic Hydrogen Production},
  author = {Palmer, Owen and Radet, Hugo and Camal, Simon and Girard, Robin},
  year = {2024},
  month = oct,
  url = {https://hal.science/hal-04756329},
  urldate = {2024-12-17},
  abstract = {The production of green hydrogen from renewable energy and water by electrolysis is considered an important technology for decarbonation of many industries. To improve the competitiveness of this burgeoning industry, many jurisdictions are introducing incentive programs, including Europe, the US, and Australia. Eligibility for these incentives is linked to electricity sourcing rules to promote the use of renewable and low-carbon sources. However, definitions of green and lowcarbon hydrogen vary between jurisdictions. One key difference is the measurement of temporal correlation between renewable sources and electrolyser consumption, with hourly, monthly, and yearly time-matching proposed. Furthermore, certain regions with cleaner grid mixes may have the option to produce low-carbon hydrogen without adherence to these rules. This paper studies the impact of these differing green and lowcarbon classification rules on sourcing strategy, equipment sizing, final cost, and grid emissions exposure of the produced hydrogen. A market-focused 2-stage stochastic model of a green hydrogen producer supplying a hydrogen demand is used, with uncertainty in renewable production and electricity spot market prices. Strict hourly time-matching is observed to increase demand for diversified power purchase agreement (PPA) portfolios, and require greater electrolyser and hydrogen storage capacities. For carbon-intensive grids, less strict time matching rules can lead to the produced hydrogen being classified as 100\% green whilst exceeding intended maximum emissions intensities.},
  keywords = {capacity,energy,futures,Hydrogen,Hydrogen renewable energy market futures stochastic optimization capacity planning uncertainty powerto-gas power-to-x time matching,market,optimization,planning,power-to-x,powerto-gas,renewable,stochastic,time matching,uncertainty},
  file = {C:\Users\scl38887\Zotero\storage\62IZPNXH\Palmer et al. - 2024 - Green and low-carbon hydrogen - the impact of clas.pdf}
}

