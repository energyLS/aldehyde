@article{Kirchem2023,
  title = {Power Sector Effects of Green Hydrogen Production in {{Germany}}},
  author = {Kirchem, Dana and Schill, Wolf-Peter},
  year = {2023},
  month = nov,
  journal = {Energy Policy},
  volume = {182},
  pages = {113738},
